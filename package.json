{
  "name": "dsh-aurora-glass",
  "version": "2.0.0",
  "description": "Aurora Glass — a lightweight global glassmorphism + aurora theme for DeepSeek Harness",
  "license": "MIT",
  "private": false,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "locale/*.json"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
